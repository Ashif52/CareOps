# CareOps AI Backend Environment Configuration (Production & Development)

# Environment Mode & Debugging (CRITICAL: Set DEBUG_MODE=false and ENVIRONMENT=production for live deployments)
ENVIRONMENT=production
DEBUG_MODE=false

# Database Connection
# SQLite (Local Dev fallback): sqlite:///./careops.db
# PostgreSQL (Production standard): postgresql://careops_user:STRONG_PASSWORD_HERE@localhost:5432/careops_db
DATABASE_URL=postgresql://careops_user:REPLACE_WITH_SECURE_PASSWORD@127.0.0.1:5432/careops_db

# Centralized Identity & JWT Session Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_MINIMUM_64_CHARACTER_RANDOM_HEX_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Hospital LAN & Network CORS
# Comma-separated list of permitted origins (e.g. server IP and LAN client IPs)
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.50:3000,https://careops.hospital.lan
FRONTEND_URL=http://192.168.1.50:3000

# Hospital SMTP Mail Server Configuration (Real SMTPS / TLS Delivery)
SMTP_HOST=smtp.hospital.domain
SMTP_PORT=465
SMTP_USER=alerts@careops.hospital
SMTP_PASSWORD=REPLACE_WITH_SECURE_SMTP_CREDENTIALS
SMTP_FROM=CareOps Hospital Dispatch <alerts@careops.hospital>
SMTP_USE_SSL=true

# Operational & Escalation Dispatch Recipients
WORK_EMAIL=admin.operations@careops.hospital
MAINTENANCE_DEPARTMENT_EMAIL=maintenance@careops.hospital
MAINTENANCE_DEPARTMENT_MOBILE=+15550199

# Private Media Storage & Upload Restraints
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# Background Service Level Agreement (SLA) & Notification Worker
SLA_CHECK_INTERVAL_SECONDS=15

