# CareOps AI Backend Environment Configuration

# Database Connection
# SQLite (Local Dev default): sqlite:///./careops.db
# PostgreSQL (Production): postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://careops:password123@localhost:5432/careops

# Security
SECRET_KEY=careops_ai_enterprise_super_secret_key_2026_production
